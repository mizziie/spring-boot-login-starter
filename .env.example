# PostgreSQL
POSTGRES_DB=javalogin
POSTGRES_USER=javalogin
POSTGRES_PASSWORD=changeme_db

# Admin default user (change in production!)
# These map to app.admin.* properties.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Administrator

# Rate limiting (login brute force protection)
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_ATTEMPT_WINDOW_SECONDS=300
RATE_LIMIT_LOCKOUT_DURATION_SECONDS=900

# Spring profile
SPRING_PROFILES_ACTIVE=docker

# JWT (generate a strong secret in production, min 32 chars)
JWT_SECRET=change-me-to-a-very-long-random-secret-key-32chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Email verification
EMAIL_VERIFICATION_REQUIRED=false

# SMTP config (optional, default uses localhost:1025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@example.com
