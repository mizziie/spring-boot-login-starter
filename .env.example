# PostgreSQL
POSTGRES_DB=javalogin
POSTGRES_USER=javalogin
POSTGRES_PASSWORD=changeme_db

# Admin default user (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin
ADMIN_EMAIL=admin@example.com

# Spring profile
SPRING_PROFILES_ACTIVE=docker

# JWT (generate a strong secret in production, min 32 chars)
JWT_SECRET=change-me-to-a-very-long-random-secret-key-32chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Email verification
EMAIL_VERIFICATION_REQUIRED=false

# SMTP config (optional, default uses localhost:1025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@example.com
